<Window x:Class="WpfApp4.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Викторина" Height="450" Width="800">
    <Grid>
        <StackPanel x:Name="HomePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,35,0,0">
            <TextBlock Text="Викторина"
                       FontSize="30"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Добро пожаловать!"
                       FontSize="18"
                       Margin="0,25,0,0"
                       HorizontalAlignment="Center" />
            <Button Content="Начать викторину"
                    Margin="0,35,0,0"
                    Click="StartQuizButton_Click" />
            <Button Content="Посмотреть результат"
                    Margin="0,15,0,0"
                    Click="ViewResultButton_Click" />
        </StackPanel>
        <StackPanel x:Name="QuizPanel"
                    Visibility="Collapsed"
                    Margin="35,30,35,0">
            <TextBlock x:Name="QuestionNumberTextBlock"
                       FontSize="18" />
            <TextBlock x:Name="QuestionTextBlock"
                       FontSize="22"
                       TextWrapping="Wrap"
                       Margin="0,18,0,0" />
            <RadioButton x:Name="Answer1RadioButton"
                         GroupName="Answers"
                         Margin="0,25,0,0"
                         FontSize="16"
                         Checked="AnswerRadioButton_Checked" />
            <RadioButton x:Name="Answer2RadioButton"
                         GroupName="Answers"
                         Margin="0,12,0,0"
                         FontSize="16"
                         Checked="AnswerRadioButton_Checked" />
            <RadioButton x:Name="Answer3RadioButton"
                         GroupName="Answers"
                         Margin="0,12,0,0"
                         FontSize="16"
                         Checked="AnswerRadioButton_Checked" />
            <RadioButton x:Name="Answer4RadioButton"
                         GroupName="Answers"
                         Margin="0,12,0,0"
                         FontSize="16"
                         Checked="AnswerRadioButton_Checked" />
            <Button x:Name="NextQuestionButton"
                    Content="Следующий вопрос"
                    Margin="0,25,0,0"
                    HorizontalAlignment="Left"
                    IsEnabled="False"
                    Click="NextQuestionButton_Click" />
            <ProgressBar x:Name="QuizProgressBar"
                         Maximum="10"
                         Margin="0,25,0,0" />
        </StackPanel>
        <StackPanel x:Name="ResultPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,70,0,0">
            <TextBlock Text="Результат викторины"
                       FontSize="28"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="ResultTextBlock"
                       FontSize="22"
                       Margin="0,30,0,0"
                       HorizontalAlignment="Center" />
            <Button Content="Пройти заново"
                    Margin="0,35,0,0"
                    Click="RestartQuizButton_Click" />
            <Button Content="На главную"
                    Margin="0,15,0,0"
                    Click="HomeButton_Click" />
        </StackPanel>
    </Grid>
</Window>
