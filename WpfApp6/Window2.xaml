<Window x:Class="WpfApp6.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Генератор рецептов"
        Width="800"
        Height="450">
    <Grid Margin="10">
        <TextBlock Text="Генератор рецептов" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Продукт" Margin="0,35,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBox x:Name="ProductNameTextBox" Width="200" Height="25" Margin="0,55,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Категория продукта" Margin="220,35,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <ComboBox x:Name="ProductCategoryComboBox" Margin="220,55,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Добавить в холодильник" Click="AddProductButton_Click" Margin="0,90,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Продукты в холодильнике" Margin="0,125,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <ListBox x:Name="ProductsListBox" Width="350" Height="65" Margin="0,145,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Удалить продукт" Click="DeleteProductButton_Click" Margin="0,220,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Тип блюда" Margin="400,35,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <ComboBox x:Name="DishTypeComboBox" SelectionChanged="DishTypeComboBox_SelectionChanged" ToolTip="Выберите тип или оставьте пустым для всех блюд" Margin="400,55,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Подобрать рецепт" Click="FindRecipesButton_Click" Margin="400,90,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <CheckBox x:Name="OnlyFullRecipesCheckBox" Content="Показывать только рецепты, которые можно приготовить полностью" Checked="RecipeFilter_Changed" Unchecked="RecipeFilter_Changed" Margin="360,125,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="AvailableRecipesTextBlock" Margin="400,150,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Рецепты" Margin="400,175,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <ListBox x:Name="RecipesListBox" Width="350" Height="50" SelectionChanged="RecipesListBox_SelectionChanged" Margin="400,195,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="MissingIngredientsTextBlock" TextWrapping="Wrap" Margin="400,250,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="CookingTimeTextBlock" Margin="400,285,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="DifficultyTextBlock" Margin="400,305,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
    </Grid>
</Window>
