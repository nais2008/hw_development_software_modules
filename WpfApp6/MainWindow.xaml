<Window x:Class="WpfApp6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Три WPF-приложения"
        Width="800"
        Height="450">
    <Grid>
        <TextBlock Text="Выберите задание" Margin="20,20,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Фитнес-трекер" Click="OpenFitnessTracker_Click" Margin="20,55,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Генератор рецептов" Click="OpenRecipeGenerator_Click" Margin="20,90,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Планировщик поездок" Click="OpenTripPlanner_Click" Margin="20,125,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
    </Grid>
</Window>
