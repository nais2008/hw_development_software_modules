<Window x:Class="WpfApp6.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фитнес-трекер"
        Width="800"
        Height="450">
    <Grid Margin="10">
        <TextBlock Text="Фитнес-трекер" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Дата тренировки" Margin="0,35,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <DatePicker x:Name="WorkoutDatePicker" SelectedDateChanged="WorkoutDatePicker_SelectedDateChanged" Margin="0,55,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Тип тренировки" Margin="220,35,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <ComboBox x:Name="WorkoutTypeComboBox" SelectionChanged="WorkoutTypeComboBox_SelectionChanged" Margin="220,55,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Длительность, минут" Margin="0,90,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBox x:Name="DurationTextBox" Width="200" Height="25" Margin="0,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Дистанция, км" Margin="220,90,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBox x:Name="DistanceTextBox" Width="200" Height="25" IsEnabled="False" Margin="220,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Вес, кг" Margin="440,90,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBox x:Name="WeightTextBox" Width="200" Height="25" Margin="440,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Добавить тренировку" Click="AddWorkoutButton_Click" Margin="0,150,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Тренировки" Margin="0,185,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <ListBox x:Name="WorkoutsListBox" Width="350" Height="65" Margin="0,205,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Удалить выбранную тренировку" Click="DeleteWorkoutButton_Click" Margin="0,280,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Недельная цель, калории" Margin="400,150,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Slider x:Name="GoalSlider" Minimum="1000" Maximum="10000" Value="5000" TickFrequency="500" IsSnapToTickEnabled="True" ValueChanged="GoalSlider_ValueChanged" Margin="400,170,10,0" VerticalAlignment="Top" />
        <TextBlock x:Name="GoalTextBlock" Margin="400,195,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="WeeklyCaloriesTextBlock" Margin="400,215,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="GoalPercentTextBlock" Margin="400,235,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="GoalMessageTextBlock" Margin="400,255,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <CheckBox x:Name="CurrentWeekCheckBox" Content="Показывать только тренировки этой недели" IsChecked="True" Checked="CurrentWeekCheckBox_Changed" Unchecked="CurrentWeekCheckBox_Changed" Margin="400,280,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
    </Grid>
</Window>
