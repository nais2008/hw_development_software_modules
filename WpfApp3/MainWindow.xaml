<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тренажёрный зал"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="539*"/>
            <RowDefinition Height="95*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Имя клиента:"
                   Margin="30,25,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"/>

        <TextBox x:Name="NameTextBox"
                 Width="250"
                 Height="25"
                 Margin="119,20,0,0"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Left"/>


        <TextBlock Text="Тип тренировки:"
                   Margin="30,65,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"/>

        <ComboBox x:Name="TrainingTypeComboBox"
                  Width="250"
                  Height="25"
                  Margin="129,60,0,0"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"/>


        <TextBlock Text="Дата (ДД.ММ.ГГГГ):"
                   Margin="30,105,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"/>

        <TextBox x:Name="DateTextBox"
                 Width="250"
                 Height="25"
                 Margin="140,100,0,0"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Left"/>


        <TextBlock Text="Длительность (мин):"
                   Margin="30,145,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"/>

        <TextBox x:Name="DurationTextBox"
                 Width="250"
                 Height="25"
                 Margin="146,140,0,0"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Left"/>


        <TextBlock Text="Зал:"
                   Margin="30,185,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"/>

        <RadioButton x:Name="MainHallRadioButton"
                     Content="Основной зал"
                     IsChecked="True"
                     Margin="71,189,0,0"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Left"/>

        <RadioButton x:Name="VipHallRadioButton"
                     Content="VIP-зал"
                     Margin="191,189,0,0"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Left"/>

        <RadioButton x:Name="PoolHallRadioButton"
                     Content="Бассейн"
                     Margin="271,189,0,0"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Left"/>


        <Button Content="Добавить посещение"
                Width="200"
                Height="35"
                Margin="30,219,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Click="AddVisitButton_Click"/>


        <ListBox x:Name="VisitsListBox"
                 Width="348"
                 Height="91"
                 Margin="425,34,0,0"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Left"/>


        <Button Content="Удалить выбранное"
                Width="180"
                Height="30"
                Margin="425,153,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Click="DeleteVisitButton_Click"/>


        <CheckBox x:Name="LongVisitsCheckBox"
                  Content="Показывать только длительные тренировки (более 60 мин)"
                  Margin="425,196,0,0"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  Checked="LongVisitsCheckBox_Changed"
                  Unchecked="LongVisitsCheckBox_Changed"/>


        <TextBlock x:Name="CountTextBlock"
                   Text="Количество посещений: 0"
                   Margin="42,270,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"/>

        <TextBlock x:Name="DurationTextBlock"
                   Text="Общая длительность: 0 мин"
                   Margin="292,270,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"/>

        <TextBlock x:Name="PriceTextBlock"
                   Text="Стоимость абонемента: 0 руб."
                   Margin="552,270,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"/>

    </Grid>
</Window>