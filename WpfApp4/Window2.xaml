<Window x:Class="WpfApp4.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Таймер обратного отсчета" Height="450" Width="800">
    <Grid>
        <TextBlock Text="Таймер обратного отсчета"
                   FontSize="26"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"
                   VerticalAlignment="Top" />
        <TextBlock Text="Время (ЧЧ:ММ:СС)"
                   Margin="30,85,0,0"
                   VerticalAlignment="Top" />
        <TextBox x:Name="TimeTextBox"
                 Margin="30,108,625,0"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top"
                 TextChanged="TimeTextBox_TextChanged" />
        <ComboBox x:Name="PresetComboBox"
                  Margin="195,108,435,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  SelectionChanged="PresetComboBox_SelectionChanged" />
        <Button x:Name="StartButton"
                Content="Старт"
                Margin="390,108,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="StartButton_Click" />
        <Button x:Name="PauseButton"
                Content="Пауза"
                Margin="390,150,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsEnabled="False"
                Click="PauseButton_Click" />
        <Button x:Name="ResetButton"
                Content="Сброс"
                Margin="510,108,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="ResetButton_Click" />
        <TextBlock x:Name="TimeDisplayTextBlock"
                   Text="00:00:00"
                   HorizontalAlignment="Center"
                   Margin="0,180,0,0"
                   VerticalAlignment="Top" />
        <ProgressBar x:Name="TimerProgressBar"
                     Maximum="100"
                     HorizontalAlignment="Stretch"
                     Margin="30,275,30,0"
                     VerticalAlignment="Top" />
        <TextBlock x:Name="StateTextBlock"
                   Text="Состояние: ожидание"
                   HorizontalAlignment="Center"
                   Margin="0,325,0,0"
                   VerticalAlignment="Top"
                   FontSize="16" />
        <TextBlock x:Name="CompletionTextBlock"
                   Text="Время вышло!"
                   Foreground="Red"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center"
                   Margin="0,365,0,0"
                   VerticalAlignment="Top"
                   FontSize="20" />
    </Grid>
</Window>
