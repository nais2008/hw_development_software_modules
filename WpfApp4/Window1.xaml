<Window x:Class="WpfApp4.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор расходов" Height="450" Width="800">
    <Grid>
        <TextBlock Text="Калькулятор расходов"
                   FontSize="26"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"
                   VerticalAlignment="Top" />
        <TextBlock Text="Название покупки"
                   Margin="25,80,0,0"
                   VerticalAlignment="Top" />
        <TextBox x:Name="PurchaseNameTextBox"
                 Margin="25,102,550,0"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top"
                 TextChanged="Input_TextChanged" />
        <TextBlock Text="Сумма"
                   Margin="265,80,0,0"
                   VerticalAlignment="Top" />
        <TextBox x:Name="AmountTextBox"
                 Margin="265,102,405,0"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top"
                 TextChanged="Input_TextChanged" />
        <TextBlock Text="Категория"
                   Margin="410,80,0,0"
                   VerticalAlignment="Top" />
        <ComboBox x:Name="CategoryComboBox"
                  Margin="410,102,230,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top" />
        <Button x:Name="AddButton"
                Content="Добавить"
                Margin="590,101,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="AddButton_Click" />
        <ListBox x:Name="ExpensesListBox"
                 Margin="25,150,240,60"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 SelectionChanged="ExpensesListBox_SelectionChanged" />
        <Button x:Name="DeleteButton"
                Content="Удалить выбранное"
                Margin="590,150,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsEnabled="False"
                Click="DeleteButton_Click" />
        <Button Content="Очистить всё"
                Margin="590,192,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="ClearButton_Click" />
        <TextBlock x:Name="TotalTextBlock"
                   Text="Общая сумма: 0 руб."
                   Margin="25,390,0,0"
                   VerticalAlignment="Top"
                   FontSize="16" />
        <TextBlock x:Name="CountTextBlock"
                   Text="Количество записей: 0"
                   Margin="280,390,0,0"
                   VerticalAlignment="Top"
                   FontSize="16" />
    </Grid>
</Window>
