<Window x:Class="WpfApp6.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Планировщик поездок"
        Width="800"
        Height="450">
    <Grid Margin="10">
        <TextBlock Text="Планировщик поездок" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Название расхода" Margin="0,35,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBox x:Name="ExpenseNameTextBox" Width="200" Height="25" Margin="0,55,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Категория" Margin="220,35,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <ComboBox x:Name="ExpenseCategoryComboBox" SelectionChanged="ExpenseCategoryComboBox_SelectionChanged" Margin="220,55,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Стоимость" Margin="370,35,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBox x:Name="ExpenseCostTextBox" Width="200" Height="25" Margin="370,55,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Дата расхода" Margin="600,35,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <DatePicker x:Name="ExpenseDatePicker" SelectedDateChanged="ExpenseDatePicker_SelectedDateChanged" Margin="600,55,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Добавить расход" Click="AddExpenseButton_Click" Margin="0,90,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Расходы" Margin="0,125,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <ListBox x:Name="ExpensesListBox" Width="350" Height="60" Margin="0,145,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Удалить выбранный расход" Click="DeleteExpenseButton_Click" Margin="0,215,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <CheckBox x:Name="ExpensiveOnlyCheckBox" Content="Показывать только расходы дороже 1000" Checked="ExpenseFilter_Changed" Unchecked="ExpenseFilter_Changed" Margin="0,250,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Общий бюджет" Margin="400,90,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBox x:Name="BudgetTextBox" Width="200" Height="25" TextChanged="BudgetTextBox_TextChanged" Margin="400,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Рассчитать" Click="CalculateButton_Click" Margin="620,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="TotalExpensesTextBlock" Margin="400,140,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="BudgetBalanceTextBlock" Margin="400,158,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="BudgetPercentTextBlock" Margin="400,176,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="BudgetStatusTextBlock" TextWrapping="Wrap" Margin="400,194,10,0" VerticalAlignment="Top" />
        <TextBlock Text="Приоритет выбранной категории: 1–5" Margin="400,218,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Slider x:Name="PrioritySlider" Minimum="1" Maximum="5" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PrioritySlider_ValueChanged" Margin="400,238,10,0" VerticalAlignment="Top" />
        <TextBlock x:Name="PriorityTextBlock" Margin="400,260,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="MostExpensiveCategoryTextBlock" Margin="400,280,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="CategoryDistributionTextBlock" TextWrapping="Wrap" Margin="10,280,400,0" VerticalAlignment="Top" />
        <TextBlock x:Name="TripDurationTextBlock" Margin="10,350,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="AverageDailyExpenseTextBlock" Margin="10,375,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock x:Name="SavingRecommendationTextBlock" TextWrapping="Wrap" Margin="400,320,10,0" VerticalAlignment="Top" />
    </Grid>
</Window>
